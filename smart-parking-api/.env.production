# Application
APP_NAME=Smart Parking Lot Management System
APP_ENV=production
DEBUG=False
API_V1_PREFIX=/api/v1

# Database (Render PostgreSQL) - set via Render env vars
# DATABASE_URL=postgresql://user:password@host:5432/smart_parking

# JWT / Security - generate a strong random key for production
SECRET_KEY=change-this-to-a-strong-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - update with your Render frontend URLs
BACKEND_CORS_ORIGINS=["https://smart-parking-customer.onrender.com","https://smart-parking-management.onrender.com"]

# Pagination defaults
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Billing
DEFAULT_HOURLY_RATE=1000.0

# Default Admin (used by seed script)
DEFAULT_ADMIN_NAME=System Admin
DEFAULT_ADMIN_EMAIL=khunsithu350@gmail.com
DEFAULT_ADMIN_PASSWORD=change-this-admin-password
DEFAULT_ADMIN_PHONE=+10000000000

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=khunsithuaung65@gmail.com
SMTP_PASSWORD='mnit qtzf wuja zrtr'
SMTP_FROM_EMAIL=khunsithuaung65@gmail.com
SMTP_FROM_NAME=Smart Parking System
SMTP_USE_TLS=True

# OTP Configuration
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

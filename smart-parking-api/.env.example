# Application
APP_NAME=Smart Parking Lot Management System
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://smart_parking_database_user:Jm6ahPTP7EJ9wm2d3YXzcqUgnVGss4pS@dpg-d9lornbl550s73ck17n0-a.singapore-postgres.render.com/smart_parking_database

# JWT / Security
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5173"]

# Pagination defaults
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Billing
DEFAULT_HOURLY_RATE=1000.0

# Default Admin (used by seed script)
DEFAULT_ADMIN_NAME=System Admin
DEFAULT_ADMIN_EMAIL=admin@smartparking.com
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_PHONE=+10000000000

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Smart Parking System
SMTP_USE_TLS=True

# OTP Configuration
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# Digital Wallet Integration (external system API)
# The base URL of the digital wallet backend. API keys are stored per payment
# account via the /wallet-accounts endpoints (admin platform + per-owner).
WALLET_API_BASE_URL=https://digital-wallet-backend-api.up.railway.app
WALLET_REFERENCE_PREFIX=PP
# Publicly reachable base URL of this API (the wallet redirects the customer
# browser here after OTP/PIN is collected on the wallet hosted page).
WALLET_REDIRECT_BASE_URL=http://localhost:8000
# Frontend base URLs the callback redirects to after a payment result.
CUSTOMER_APP_URL=http://localhost:5174
MANAGEMENT_APP_URL=http://localhost:5173